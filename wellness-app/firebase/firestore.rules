rules_version = '2';

// ============================================================================
// WellnessID（仮）Firestore セキュリティルール — 骨格
//
// 出典：アプリ企画書 Rev.3（2026/09/25）⑩ DB設計
//
// 【考え方】既定は「誰も書けない」。書き込みは
//   ・運営（Firebaseコンソール / 管理スクリプト）
//   ・Cloud Functions（Admin SDK）
// のどちらかだけに限る。アプリから直接書けるのは自分のプロフィールとお気に入りのみ。
//
// Rev.3 で削除：memberProfiles / reservations / trainingLogs / plans
//               role == 'member' の判定も不要になった（guest / free の2値のみ）。
//
// ⚠️ 人が必ずレビューすること。@firebase/rules-unit-testing でテストを書くまで本番に上げない。
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 運営（Custom Claims の admin）。付与は運営スクリプトからのみ。
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ---------- マスタ（誰でも読める・運営のみ書込） ----------
    match /concerns/{concernId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- アイテム（商品・店舗・専門家） ----------
    // 未ログインでも閲覧可（企画書②：登録不要で閲覧できる）
    match /items/{itemId} {
      allow read: if true;
      // 集計値（avgScore / reviewCount / repeatRate / cohortScores）の更新は
      // Functions（Admin SDK）のみ。クライアントは一切書けない。
      allow write: if isAdmin();

      // ---------- 口コミ ----------
      match /reviews/{reviewId} {
        allow read: if true;
        // 投稿は Callable Function 経由（検証＋集計のトランザクション更新が必要）
        allow create, update, delete: if false;
      }
    }

    match /serviceDetails/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /proDetails/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 新着フィード用のフラットコレクション（Functions が書き込む）
    match /reviews_index/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /columns/{columnId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rev.3：会員限定の出し分けは廃止。全ユーザー共通。
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- ランキング（読取専用） ----------
    match /rankings/{document=**} {
      allow read: if true;
      allow write: if false; // Functions の Admin SDK のみ
    }

    // ---------- ユーザー ----------
    match /users/{uid} {
      // プロフィールは本人のみ読取。口コミの表示には authorSnapshot を使うため、
      // 他人の users ドキュメントを読む必要はない。
      allow read: if isSelf(uid);
      allow create: if isSelf(uid);
      // role は Custom Claims 側が正。ここから書き換えさせない。
      allow update: if isSelf(uid)
                    && request.resource.data.role == resource.data.role;
      // TODO-A(M1): 退会時の扱い。口コミを残す方針なら、アカウント削除は
      // Callable Function で users 削除 ＋ authorSnapshot 匿名化を行う。
      allow delete: if false;

      match /favorites/{itemId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---------- 通報（作成のみ許可・読取は運営のみ） ----------
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if false; // Callable（reportReview）経由のみ
      allow update, delete: if isAdmin();
    }

    // 上記に当てはまらないパスは全拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
