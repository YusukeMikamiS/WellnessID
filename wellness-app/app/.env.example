# アプリの環境変数（Expo は EXPO_PUBLIC_ で始まる変数だけをアプリに埋め込む）
# このファイルを .env にコピーして使う。.env はコミットしない（.gitignore 済み）。
#
# 何も設定しなければ、開発中は Firebase Emulator（demo-wellnessid）につながる。

# Emulator を使わず本物のプロジェクトにつなぐときは false にする
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true

# Emulator のホスト。空なら自動（Expo の開発サーバーのホスト。Web は 127.0.0.1）
# 実機でつながらないときは、パソコンの IP アドレスを入れる（例：192.168.1.23）
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# 本物のプロジェクトの設定値（Firebase コンソール → プロジェクトの設定 → マイアプリ で確認）
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
