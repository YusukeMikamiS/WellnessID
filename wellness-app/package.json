{
  "name": "wellness-app",
  "private": true,
  "version": "0.1.0",
  "description": "WellnessID (仮) — ウェルネス口コミプラットフォーム / Motoazabu LIFE CREATE Salon 会員アプリ",
  "workspaces": [
    "app",
    "functions"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,mts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,js,json,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "test": "npm run test --workspaces --if-present",
    "emu": "npm run build -w functions && firebase emulators:start --project demo-wellnessid --import=.emulator-data --export-on-exit=.emulator-data",
    "seed": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed/index.mts",
    "seed:check": "npm run seed -- --dry-run",
    "rankings": "node --disable-warning=ExperimentalWarning scripts/rankings.mts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3"
  }
}
