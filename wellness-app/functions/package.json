{
  "name": "@wellness/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/functions/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "test": "echo \"(集計ロジックのテストをここに追加する)\" && exit 0",
    "test:rules": "node --disable-warning=ExperimentalWarning --test \"test/rules/*.test.mts\""
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "typescript": "~5.6.3"
  }
}
