{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Node 22 の CommonJS 向け。moduleResolution: "node"（=node10）は
    // TypeScript 7.0 で廃止されるため node16 を使う。
    // functions/package.json に "type": "module" が無いので CommonJS で出力される。
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "lib",
    // 型の正本 app/src/types を相対パスで import し、一緒にビルドする。
    // rootDir をワークスペース直下にするため、出力は lib/functions/src/ と lib/app/src/types/ になる。
    // デプロイでアップロードされるのは functions/ の中だけだが、ビルド結果は lib/ に入るので問題ない。
    "rootDir": "..",
    "noEmit": false,
    "isolatedModules": false
  },
  "include": ["src/**/*.ts", "../app/src/types/**/*.ts"],
  "exclude": ["node_modules", "lib"]
}
