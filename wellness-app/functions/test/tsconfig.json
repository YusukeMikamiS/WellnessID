{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ルールのテスト用。scripts/ と同じく Node 22 の型除去（type stripping）でそのまま実行するため、
    // 相対 import には拡張子（.mts）を付け、tsc は型チェックだけに使う。
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.mts"]
}
